# Application
APP_ENV=development
APP_BASE_URL=http://localhost:8000
MCP_BASE_URL=http://localhost:8000
AUTH_BASE_URL=http://localhost:8000

# Yandex OAuth (required)
YANDEX_CLIENT_ID=your_client_id_here
YANDEX_CLIENT_SECRET=your_client_secret_here
YANDEX_REDIRECT_URI=http://localhost:8000/auth/callback
YANDEX_ORG_ID=your_org_id_here

# Database
POSTGRES_DSN=postgresql+asyncpg://wiki:wiki@localhost:5432/wiki

# Redis
REDIS_DSN=redis://localhost:6379/0

# Token encryption key (Fernet key, generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=your_fernet_key_here

# Session settings
AUTH_SESSION_TTL_SECONDS=900
PAGE_CACHE_TTL_SECONDS=300
ACCESS_TOKEN_REFRESH_SKEW_SECONDS=60

# Logging
LOG_LEVEL=INFO
